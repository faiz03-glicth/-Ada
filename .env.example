# Copy to .env and fill in. Never commit .env.
# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Cloud → APIs & Services → Credentials (OAuth client IDs)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=0000000000-xxxxxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=0000000000-yyyyyyyy.apps.googleusercontent.com

# Where /terms, /privacy, /acknowledgements and /help are hosted (no trailing slash)
EXPO_PUBLIC_LEGAL_BASE_URL=https://streak.example.com
